# Fantasy Nerds API Key
# Get your API key from: https://www.fantasyfootballnerds.com/api-access
FFNERD_API_KEY=your_api_key_here

# Sleeper League ID (optional, defaults to Token Bowl)
# Find your league ID in the URL when viewing your league on Sleeper
# This is the league used when a tool call omits its optional league_id argument.
SLEEPER_LEAGUE_ID=123456789

# Named leagues (optional) - JSON object mapping friendly names to Sleeper
# league IDs. Pass any of these names as a tool's league_id argument instead
# of the raw ID. Malformed/missing JSON is ignored (logged, not fatal).
# Example: SLEEPER_LEAGUES={"tejas": "1315471209655181312", "work": "222...", "family": "333..."}
SLEEPER_LEAGUES={}

# Your Sleeper user_id (optional) - lets get_my_roster() find your roster in
# any configured league by matching it against each roster's owner_id,
# instead of having to know the roster_id per league.
# Find your user_id at https://api.sleeper.app/v1/user/<your_username>
SLEEPER_USER_ID=123456789

# Redis URL (for production/caching)
# For local development: redis://localhost:6379
# For production: your Redis provider URL
REDIS_URL=redis://localhost:6379

# Logfire Token for observability and logging
# Get your token from: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=your_logfire_token_here

# Anthropic API Key for Claude SDK
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Token Bowl Chat API Key
# Authentication is done via query parameter in SSE connection URL
# Example: https://tokenbowl-mcp.haihai.ai/sse?api_key=your_token_bowl_chat_api_key
# No environment variable needed!